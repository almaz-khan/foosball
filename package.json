{
  "name": "foosball",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*",
    "#foosball/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "bun build/index.js",
    "cli": "bun run src/cli.ts",
    "migrate": "bun run src/cli.ts migrate",
    "seed": "bun run src/cli.ts seed",
    "db:up": "docker compose up -d --wait postgres",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "bun test",
    "e2e": "bun run build && playwright test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && tsc --noEmit"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}

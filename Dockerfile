# Foosball: SvelteKit (adapter-node) served by Bun, with the CLI alongside it so
# `railway ssh --service foosball -- bun run src/cli.ts ...` works in production
# (migrations, orgs, invites, members, the Mongo import).

FROM oven/bun:1.3.14-slim AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
RUN bun run build

FROM oven/bun:1.3.14-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production
COPY --from=build /app/build ./build
# The CLI runs from source; the web server does not need it.
COPY src ./src
# Migrations generated by drizzle-kit; `cli.ts migrate` applies them (pre-deploy).
COPY drizzle ./drizzle
COPY tsconfig.json ./
USER bun
EXPOSE 3000
ENV PORT=3000
CMD ["bun", "build/index.js"]

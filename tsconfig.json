{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "$app/types"]
  },
  "include": ["src", "tests", "e2e", "playwright.config.ts", "drizzle.config.ts"],
  "extends": "$app/tsconfig"
}

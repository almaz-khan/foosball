# Local Postgres from compose.yml (`bun run db:up`).
DATABASE_URL=postgres://postgres:postgres@localhost:5434/foosball
# Exact address you open Foosball at: the login hub sends people back to
# $FOOSBALL_ORIGIN/auth/callback, which must be listed for the app in the hub.
# https, or http on localhost.
FOOSBALL_ORIGIN=http://localhost:5180
# Sign-in goes through the login hub (OpenID Connect). Locally, run the fake
# hub (`bun run fakehub`), which signs you in as "Almaz" with a passkey.
# Production: OIDC_ISSUER=https://login.almaz.dev (the default), client id
# `foosball`, and the secret the hub's admin UI showed when the app was added.
OIDC_ISSUER=http://localhost:4455
OIDC_CLIENT_SECRET=dev-secret
# OIDC_CLIENT_ID=foosball
# How long an org invite link works.
INVITE_HOURS=48

# Local Postgres from compose.yml (`bun run db:up`).
DATABASE_URL=postgres://postgres:postgres@localhost:5434/foosball
# Exact address you open Foosball at. Passkeys are bound to its hostname, so it
# must be localhost or an HTTPS name, never an IP.
FOOSBALL_ORIGIN=http://localhost:5180
# How long an org invite link works.
INVITE_HOURS=48
